<form method="POST" action="{{ form_action }}" class="project-form">
    {% if status == 'success' %}
        <div class="form-alert success">Saved successfully.</div>
    {% endif %}

    {% if error %}
        <div class="form-alert error">{{ error }}</div>
    {% endif %}

    <div class="form-section">
        <label for="title" class="form-label">Project Name</label>
        <input
            type="text"
            id="title"
            name="title"
            class="form-input"
            placeholder="Enter project name"
            value="{{ request.form.get('title', project.title if project else '') }}"
            minlength="3"
            maxlength="100"
            required
        >
    </div>

    <div class="form-section">
        <label for="description" class="form-label">Description</label>
        <textarea
            id="description"
            name="description"
            class="form-textarea"
            placeholder="Brief description of the project"
            rows="6"
            maxlength="512"
        >{{ request.form.get('description', project.description if project and project.description else '') }}</textarea>
    </div>

    <div class="form-section">
        <label for="budget_amount" class="form-label">Budget Amount</label>
        <input
            type="number"
            id="budget_amount"
            name="budget_amount"
            class="form-input"
            placeholder="Optional project budget"
            value="{{ request.form.get('budget_amount', project.budget_amount if project and project.budget_amount is not none else '') }}"
            min="0"
            step="0.01"
        >
    </div>

    <div class="form-actions">
        <a href="{{ cancel_url }}" class="button-secondary">Cancel</a>
        <button type="submit" class="button">{{ submit_label }}</button>
    </div>
</form>
