{% extends "base/dashboard.html.j2" %}

{% block title %}Files{% endblock %}

{% block extra_css %}
    <link rel="stylesheet" href="{{ url_for('static', filename='css/pages/project/files.css') }}">
{% endblock %}

{% block page_header %}
    <h1>Files</h1>
{% endblock %}

{% block page_header_actions %}
    <a href="{{ url_for('project.home', project_id=project['id']) }}" class="button-secondary">&larr; Back</a>
    {% if can_edit_project %}
        <a href="{{ url_for('project.file_upload', project_id=project['id']) }}" class="button">Upload Files</a>
    {% endif %}
{% endblock %}

{% block main_content %}
    <div class="files-page-grid">
        <section class="project-section">
            <div class="section-header">
                <h2>Project Files</h2>
            </div>

            {% if files %}
                <div class="files-table-wrapper">
                    <table class="files-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Uploaded</th>
                                <th class="center files-table-action">Download</th>
                                {% if can_edit_project %}
                                    <th class="center files-table-action">Delete</th>
                                {% endif %}
                            </tr>
                        </thead>

                        <tbody>
                            {% for file in files %}
                                <tr>
                                    <td>{{ file.file_name_original }}</td>
                                    <td>{{ file.file_category }}</td>
                                    <td>{{ file.description or "" }}</td>
                                    <td>{{ file.upload_date }}</td>
                                    <td class="center files-table-action">
                                        <a class="table-link" href="{{ url_for('project.download_file', project_id=project['id'], file_id=file['id']) }}" target="_blank">
                                            &plus;
                                        </a>
                                    </td>
                                    {% if can_edit_project %}
                                        <td class="center files-table-action">
                                            <a class="table-link del" href="{{ url_for('project.delete_file', project_id=project['id'], file_id=file['id']) }}">
                                                &times;
                                            </a>
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="section-empty-text">No files uploaded yet.</p>
            {% endif %}
        </section>
    </div>
{% endblock %}
