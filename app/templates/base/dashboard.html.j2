<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Dashboard{% endblock %}</title>

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="{{ url_for('static', filename='css/base/variables.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename='css/base.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename='css/layout/dashboard.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename='css/components/sidebar.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename='css/components/topbar.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename='css/components/page-header.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename='css/components/buttons.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename='css/components/cards.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename='css/components/footer.css') }}">
        <link rel="stylesheet" href="{{ url_for('static', filename='css/components/popup-box.css') }}">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        {% block extra_css %}{% endblock %}
    </head>

    <body class="dashboard-body">
        {% with popup_messages = get_flashed_messages(with_categories=true) %}
            {% if popup_messages %}
                <div class="popup-box-overlay" data-popup-box>
                    <div class="popup-box-window" role="alertdialog" aria-modal="true">
                        <button type="button" class="popup-box-close" aria-label="Close" data-popup-box-close>&times;</button>

                        {% for category, message in popup_messages %}
                            <section class="popup-box-panel popup-box-panel-{{ category|replace('_', '-') }}">
                                <p class="popup-box-kicker">
                                    {% if category == "success" %}
                                        Update Complete
                                    {% elif category == "error" %}
                                        Action Needed
                                    {% else %}
                                        Notice
                                    {% endif %}
                                </p>

                                {% if message is mapping %}
                                    <h2 class="popup-box-title">{{ message.title }}</h2>

                                    {% if message.body %}
                                        <p class="popup-box-body">{{ message.body }}</p>
                                    {% endif %}

                                    {% if message.created is defined or message.skipped is defined %}
                                        <div class="popup-box-stats">
                                            {% if message.created is defined %}
                                                <article class="popup-box-stat">
                                                    <span class="popup-box-stat-label">Inserted</span>
                                                    <strong class="popup-box-stat-value">{{ message.created }}</strong>
                                                </article>
                                            {% endif %}

                                            {% if message.skipped is defined %}
                                                <article class="popup-box-stat">
                                                    <span class="popup-box-stat-label">Skipped</span>
                                                    <strong class="popup-box-stat-value">{{ message.skipped }}</strong>
                                                </article>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                {% else %}
                                    <h2 class="popup-box-title">
                                        {% if category == "error" %}
                                            Something went wrong
                                        {% elif category == "success" %}
                                            Success
                                        {% else %}
                                            Notice
                                        {% endif %}
                                    </h2>
                                    <p class="popup-box-body">{{ message }}</p>
                                {% endif %}
                            </section>
                        {% endfor %}

                        <div class="popup-box-actions">
                            <button type="button" class="button" data-popup-box-close>Continue</button>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endwith %}

        <div class="dashboard-layout">
            <aside class="sidebar" id="app-sidebar">
                <div class="sidebar-inner">
                    <div class="sidebar-header">
                        <div class="sidebar-logo">
                            <a href="{{ url_for('dashboard.main') }}" class="logo-link">
                                <img
                                    src="{{ url_for('static', filename='assets/logo/pandata-logo.png') }}"
                                    alt="Pandata logo"
                                    class="sidebar-logo-image"
                                >
                                <span class="logo-text">Pandata</span>
                            </a>
                        </div>

                        <button
                            type="button"
                            class="sidebar-toggle"
                            id="app-sidebar-toggle"
                            aria-controls="app-sidebar"
                            aria-expanded="true"
                            aria-label="Collapse navigation sidebar"
                            title="Collapse navigation sidebar"
                        >
                            <i class="bi bi-chevron-left sidebar-toggle-icon" aria-hidden="true"></i>
                            <span class="sr-only">Toggle navigation sidebar</span>
                        </button>
                    </div>

                    <nav class="sidebar-nav">
                        <a href="{{ url_for('dashboard.main') }}"
                           class="sidebar-link{% if request.endpoint == 'dashboard.main' %} active{% endif %}">
                            <i class="bi bi-speedometer2 sidebar-link-icon" aria-hidden="true"></i>
                            <span class="sidebar-link-text">Dashboard</span>
                        </a>

                        <a href="{{ url_for('dashboard.timeline') }}"
                           class="sidebar-link{% if request.endpoint == 'dashboard.timeline' %} active{% endif %}">
                            <i class="bi bi-calendar3 sidebar-link-icon" aria-hidden="true"></i>
                            <span class="sidebar-link-text">Calendar</span>
                        </a>

                        <a href="{{ url_for('project.create') }}"
                           class="sidebar-link{% if request.endpoint == 'project.create' %} active{% endif %}">
                            <i class="bi bi-plus-circle sidebar-link-icon" aria-hidden="true"></i>
                            <span class="sidebar-link-text">New Project</span>
                        </a>
                    </nav>

                    {% if request.view_args and request.view_args.get('project_id') %}
                        {% set current_project_id = request.view_args.get('project_id') %}

                        <div class="sidebar-section">
                            <p class="sidebar-section-title">Current Project</p>

                            <div class="sidebar-project-list">
                                <a href="{{ url_for('project.home', project_id=current_project_id) }}" class="sidebar-link{% if request.endpoint == 'project.home' %} active{% endif %}">
                                    <i class="bi bi-house-door sidebar-link-icon" aria-hidden="true"></i>
                                    <span class="sidebar-link-text">Home</span>
                                </a>
                                <a href="{{ url_for('project.calendar', project_id=current_project_id) }}" class="sidebar-link{% if request.endpoint == 'project.calendar' %} active{% endif %}">
                                    <i class="bi bi-calendar2-week sidebar-link-icon" aria-hidden="true"></i>
                                    <span class="sidebar-link-text">Calendar</span>
                                </a>
                                <a href="{{ url_for('project.file_list', project_id=current_project_id) }}" class="sidebar-link{% if request.endpoint == 'project.file_list' %} active{% endif %}">
                                    <i class="bi bi-folder2-open sidebar-link-icon" aria-hidden="true"></i>
                                    <span class="sidebar-link-text">Files</span>
                                </a>
                                <a href="{{ url_for('project.people', project_id=current_project_id) }}" class="sidebar-link{% if request.endpoint == 'project.people' %} active{% endif %}">
                                    <i class="bi bi-people sidebar-link-icon" aria-hidden="true"></i>
                                    <span class="sidebar-link-text">People</span>
                                </a>
                                <a href="{{ url_for('project.visualizations', project_id=current_project_id) }}" class="sidebar-link{% if request.endpoint == 'project.visualizations' %} active{% endif %}">
                                    <i class="bi bi-bar-chart-line sidebar-link-icon" aria-hidden="true"></i>
                                    <span class="sidebar-link-text">Visualizations</span>
                                </a>
                                <a href="{{ url_for('project.timeline', project_id=current_project_id) }}" class="sidebar-link{% if request.endpoint == 'project.timeline' %} active{% endif %}">
                                    <i class="bi bi-calendar3 sidebar-link-icon" aria-hidden="true"></i>
                                    <span class="sidebar-link-text">Timeline</span>
                                </a>
                                <a href="{{ url_for('project.reports', project_id=current_project_id) }}" class="sidebar-link{% if request.endpoint == 'project.reports' %} active{% endif %}">
                                    <i class="bi bi-file-earmark-bar-graph sidebar-link-icon" aria-hidden="true"></i>
                                    <span class="sidebar-link-text">Reports</span>
                                </a>
                                <a href="{{ url_for('project.finance', project_id=current_project_id) }}" class="sidebar-link{% if request.endpoint == 'project.finance' %} active{% endif %}">
                                    <i class="bi bi-cash-stack sidebar-link-icon" aria-hidden="true"></i>
                                    <span class="sidebar-link-text">Finance</span>
                                </a>
                                <a href="{{ url_for('project.settings', project_id=current_project_id) }}" class="sidebar-link{% if request.endpoint == 'project.settings' %} active{% endif %}">
                                    <i class="bi bi-sliders sidebar-link-icon" aria-hidden="true"></i>
                                    <span class="sidebar-link-text">Settings</span>
                                </a>
                            </div>
                        </div>
                    {% endif %}

                    <div class="sidebar-section">
                        <p class="sidebar-section-title">Projects</p>

                        <div class="sidebar-project-list">
                            {% for id, project_data in sidebar_projects.items() %}
                                <a href="{{ url_for('project.home', project_id=id) }}"
                                   class="sidebar-link{% if request.view_args and request.view_args.get('project_id')|string == id|string %} active{% endif %}">
                                    <i class="bi bi-folder sidebar-link-icon" aria-hidden="true"></i>
                                    <span class="sidebar-link-text">{{ project_data['title'] }}</span>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </aside>

            <div class="main-area">
                <header class="topbar">
                    <div class="topbar-inner">
                        <div class="topbar-left">
                            {% block topbar_left %}
                                <!-- Just Empty for now, if we need to put something on the left side we can -->
                            {% endblock %}
                        </div>

                        <div class="topbar-right">
                            {% block topbar_right %}
                                <a href="{{ url_for('dashboard.about_your_data') }}" class="topbar-link">
                                    <i class="bi bi-question-circle" aria-hidden="true"></i>
                                    About Your Data
                                </a>
                                <a href="{{ url_for('dashboard.account_settings') }}" class="topbar-link">
                                    <i class="bi bi-people" aria-hidden="true"></i>
                                    Account Settings
                                </a>
                                <a href="{{ url_for('authentication.logout') }}" class="topbar-link">Logout</a>
                            {% endblock %}
                        </div>
                    </div>
                </header>

                <main class="content">
                    <div class="content-container">
                        <div class="page-header">
                            <div class="page-header-main">
                                <div class="page-header-text">
                                    {% block page_header %}{% endblock %}
                                </div>

                                <div class="page-header-actions">
                                    {% block page_header_actions %}{% endblock %}
                                </div>
                            </div>
                        </div>

                        <div class="page-content">
                            {% block main_content %}{% endblock %}
                        </div>
                    </div>

                    <footer class="site-footer">
                        &copy; 2026 Pandata &middot; Kent State University
                    </footer>
                </main>
            </div>
        </div>

        <script src="{{ url_for('static', filename='js/components/sidebar-toggle.js') }}"></script>
        {% block extra_js %}{% endblock %}
        <script src="{{ url_for('static', filename='js/components/popup-box.js') }}"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
